#!/usr/bin/env python

import os, argparse
from version import __version__
from src.lm_based_tagger.distilbert_preprocessing import AVAILABLE_FEATURES, DEFAULT_FEATURES

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

def get_version():
    """Return the current version of SCALAR tagger."""
    return f"SCALAR tagger {__version__}"

def resolve_path(path):
    return path if os.path.isabs(path) else os.path.join(SCRIPT_DIR, path)

def ensure_nltk_words():
    """Download the NLTK words corpus (used by the dictionary flag) only if it is missing."""
    import nltk
    try:
        nltk.data.find("corpora/words")
    except LookupError:
        nltk.download("words")

if __name__ == "__main__":
    """
    Use argparse to allow the user to choose either running the tagger or training a new tagger

    Example Usage:
    python main --version                            # Display the application version.
    python main --mode run                           # Start the server for tagging requests.
    python main --mode run --local                   # Serve the locally trained model in output/best_model.
    python main --mode train                         # Retrain the model with every feature.
    python main --mode train --features context type # Retrain with only the listed features.
    python main --mode train --no-features           # Retrain without feature tokens.
    python main --mode train --seed 7                # Retrain with a different training seed.
    python main --mode run --address [host]          # Run the tagger on a specific IP address
    python main --mode run --port [port]             # Run the tagger on a specific port
    python main --mode run --protocol [http/https]   # Specify use of http or https
    python main --mode run --word [path]             # Specify path of word list

    Note:
    If no arguments are provided or if there is an invalid argument, the script will display usage instructions.
    """

    parser = argparse.ArgumentParser(description="SCALAR identifier tagger")
    parser.add_argument("-v", "--version", action="store_true", help="print tagger application version")
    parser.add_argument("--local", action="store_true", help="Use local model/tokenizer instead of HuggingFace repo.")
    # Core run/train model arguments
    parser.add_argument("--mode", choices=["train", "run"], help="Choose to 'train' or 'run' the model")
    # Kept so existing `--model_type lm_based` invocations still work; the tree-based model was removed in 3.0.0.
    parser.add_argument("--model_type", choices=["lm_based"], default="lm_based", help=argparse.SUPPRESS)
    parser.add_argument("--input_path", type=str, help="Path to TSV file for training")
    parser.add_argument("--config_path", type=str, default="serve.json", help="Path to config JSON (used in run mode)")
    feature_group = parser.add_mutually_exclusive_group()
    feature_group.add_argument(
        "--features",
        nargs="+",
        choices=AVAILABLE_FEATURES,
        default=DEFAULT_FEATURES,
        metavar="FEATURE",
        help=f"Feature tokens to train with (train mode). Choices: {', '.join(AVAILABLE_FEATURES)}. "
             "Default: all of them.",
    )
    parser.add_argument(
        "--seed",
        type=int,
        help="Training seed (train mode): weight init, batch order, augmentation. The holdout split "
             "is fixed, so runs with different seeds are comparable. Default: 209.",
    )
    feature_group.add_argument(
        "--no-features",
        dest="features",
        action="store_const",
        const=[],
        help="Train without any feature tokens (train mode).",
    )

    # Run-specific options
    parser.add_argument("--port", type=int, help="Port to bind server")
    parser.add_argument("--protocol", type=str, help="Protocol (http/https)")
    parser.add_argument("--word", type=str, help="Path to the word list (approved abbreviations)")
    parser.add_argument("--address", type=str, help="Server address")

    args = parser.parse_args()
    if not args.version and args.mode is None:
        parser.error("--mode is required unless --version is given")

    if args.version:
        print(get_version())
    elif args.mode == "train":
        from src.lm_based_tagger.train_model import train_lm
        seed_args = {} if args.seed is None else {"train_seed": args.seed}
        train_lm(SCRIPT_DIR, selected_features=args.features, **seed_args)

    elif args.mode == "run":
        from src.tag_identifier import start_server
        ensure_nltk_words()

        config = {
            'script_dir': SCRIPT_DIR,
            'config_path': resolve_path(args.config_path),
            'model': os.path.join(SCRIPT_DIR, 'output', 'best_model') if args.local else 'sourceslicer/scalar_lm_best',
            'local': args.local,
        }
        if args.port:
            config["port"] = args.port
        if args.protocol:
            config["protocol"] = args.protocol
        if args.word:
            config["words"] = args.word
        if args.address:
            config["address"] = args.address

        start_server(temp_config=config)
    else:
        parser.print_usage()
