#!/usr/bin/env python
"""
Run SCALAR from a checkout of the repository: `python main --mode serve --stdio`.

This is the same as the installed `scalar-tagger` command, except that it also picks up
serve.json and output/best_model from the repository when no model is named.
"""

import os
import sys

from scalar_tagger.cli import main

if __name__ == "__main__":
    sys.exit(main(base_dir=os.path.dirname(os.path.abspath(__file__)), discover_local=True))
